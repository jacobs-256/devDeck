{
  "name": "@devdeck/plugin-sdk",
  "version": "2.0.0",
  "description": "Official SDK for building DevDeck Marketplace plugins",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "devdeck",
    "plugin",
    "sdk",
    "marketplace"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jacobs-256/devToolBox.git",
    "directory": "packages/plugin-sdk"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
