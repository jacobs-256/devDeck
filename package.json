{
  "name": "devdeck",
  "version": "3.0.0",
  "description": "Plugin-first desktop toolbox built with Rust, React, and Tauri 2",
  "author": "Jacobs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/XthingsJacobs/devDeck.git"
  },
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @devdeck/desktop tauri dev",
    "tauri:dev": "pnpm --filter @devdeck/desktop tauri dev",
    "build": "pnpm --filter @devdeck/desktop build && pnpm --filter @devdeck/plugin-sdk build",
    "typecheck": "pnpm --filter @devdeck/desktop exec tsc -p tsconfig.json --noEmit && pnpm --filter @devdeck/plugin-sdk exec tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @devdeck/desktop test",
    "lint": "pnpm lint:manifests && pnpm lint:legacy && eslint . --max-warnings 0",
    "lint:manifests": "node scripts/lint-marketplace.mjs",
    "lint:legacy": "node scripts/check-legacy-imports.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:mac": "pnpm --filter @devdeck/desktop tauri build --bundles app,dmg",
    "package:win": "pnpm --filter @devdeck/desktop tauri build --bundles nsis",
    "package:all": "pnpm --filter @devdeck/desktop tauri build",
    "marketplace:acceptance": "bash scripts/marketplace-acceptance.sh",
    "release:rehearse": "bash scripts/updater-rehearsal.sh"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.8.1",
    "typescript": "^5.6.3"
  }
}
