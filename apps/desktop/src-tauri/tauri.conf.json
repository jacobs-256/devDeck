{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevDeck",
  "version": "3.0.4",
  "identifier": "com.devdeck.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevDeck",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: plugin: http://plugin.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; frame-src 'self' plugin: http://plugin.localhost; connect-src 'self' ipc: http://ipc.localhost ws: wss:",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Cross-platform developer toolbox",
    "longDescription": "DevDeck bundles everyday developer utilities and an open plugin Marketplace with an explicit, auditable permission model.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/jacobs-256/devDeck/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVEMDQ5QTNEREY1RDI4QzcKUldUSEtGM2ZQWm9FWGZOUHkwTnZaOHZZT3lHcUxLSEZpbHBHeE5ZY09EUDRCNlNSdlFSMEZOSWQK"
    }
  }
}
